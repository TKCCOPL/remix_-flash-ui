# Admin Credentials
ADMIN_USER=admin
ADMIN_PASS=your_strong_password_here

# Security Key for JWT (Generate a 32+ char random string)
# e.g., run `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=your_random_64_char_string_here

# CSRF signing secret (required in production; generate a 32+ char random string)
# e.g., run `python -c "import secrets; print(secrets.token_hex(32))"`
CSRF_SECRET=your_random_64_char_string_here

# Optional: comma-separated old secrets for key rotation (grace period)
# CSRF_SECRET_FALLBACKS=old_secret_1,old_secret_2

# CORS Origins (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Trust X-Forwarded-For / X-Real-IP from reverse proxies
TRUST_PROXY_HEADERS=false

# ── OAuth Configuration ─────────────────────────────────────────────────────
# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/oauth/github/callback

# Gitee OAuth (https://gitee.com/oauth/applications)
GITEE_CLIENT_ID=your_gitee_client_id
GITEE_CLIENT_SECRET=your_gitee_client_secret
GITEE_REDIRECT_URI=http://localhost:8000/api/oauth/gitee/callback

# Guest JWT Secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
GUEST_JWT_SECRET=your_guest_jwt_secret_here

# ── Email Configuration ─────────────────────────────────────────────────────
EMAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@blog.xiaocc.dev
