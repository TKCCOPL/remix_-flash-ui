# ── Admin Credentials ────────────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASS=your_strong_password_here

# ── Security Keys (generate with: python3 -c "import secrets; print(secrets.token_hex(32))") ──
SECRET_KEY=your_random_64_char_string_here
CSRF_SECRET=your_random_64_char_string_here
GUEST_JWT_SECRET=your_random_64_char_string_here

# Optional: comma-separated old secrets for CSRF key rotation (grace period)
# CSRF_SECRET_FALLBACKS=old_secret_1,old_secret_2

# ── Environment ─────────────────────────────────────────────────────────────
# Set to 'production' to skip seed data on startup
# ENVIRONMENT=production

# ── Frontend URL (for OAuth redirect after login) ───────────────────────────
FRONTEND_URL=https://blog.xiaocc.dev

# ── Proxy / Networking ──────────────────────────────────────────────────────
# MUST be 'true' in production (behind Nginx/reverse proxy) for rate limiting to work
TRUST_PROXY_HEADERS=true

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=https://blog.xiaocc.dev

# ── Logging ─────────────────────────────────────────────────────────────────
# DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# ── OAuth: GitHub ───────────────────────────────────────────────────────────
# https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=https://blog.xiaocc.dev/api/oauth/github/callback

# ── OAuth: Gitee ────────────────────────────────────────────────────────────
# https://gitee.com/oauth/applications
GITEE_CLIENT_ID=your_gitee_client_id
GITEE_CLIENT_SECRET=your_gitee_client_secret
GITEE_REDIRECT_URI=https://blog.xiaocc.dev/api/oauth/gitee/callback

# ── Email Notifications (optional) ───────────────────────────────────────────
# Set to 'true' to enable email notifications for comment replies
EMAIL_ENABLED=false
# SMTP_HOST=smtp.163.com
# SMTP_PORT=465
# SMTP_USER=your_email@163.com
# SMTP_PASSWORD=your_smtp_authorization_code
# SMTP_FROM=your_email@163.com
# SMTP_USE_SSL=true
# SITE_URL=https://blog.xiaocc.dev
