# ── 本地开发专用配置 ─────────────────────────────────────────────────────────
# 此文件用于本地开发，会覆盖 .env 中的同名变量
# 复制为 .env.local 并根据需要修改

# 环境标识
ENVIRONMENT=development

# ── 本地开发端口 ─────────────────────────────────────────────────────────────
# 前端: http://localhost:3000
# 后端: http://localhost:8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 本地开发不需要代理头
TRUST_PROXY_HEADERS=false

# ── OAuth 回调（指向本地）────────────────────────────────────────────────────
# 注意：需要在 GitHub/Gitee OAuth App 中同时配置本地和生产回调 URL
GITHUB_REDIRECT_URI=http://localhost:8001/api/oauth/github/callback
GITEE_REDIRECT_URI=http://localhost:8001/api/oauth/gitee/callback

# ── 日志级别（开发时可用 DEBUG）──────────────────────────────────────────────
LOG_LEVEL=DEBUG
