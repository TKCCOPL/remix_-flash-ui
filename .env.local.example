# ── 本地开发专用配置 ─────────────────────────────────────────────────────────
# 此文件会覆盖 .env 中的同名变量
# 复制为 .env.local 并根据需要修改

# 环境标识
ENVIRONMENT=development

# ── 本地开发端口 ─────────────────────────────────────────────────────────────
# 前端: http://localhost:3000
# 后端: http://localhost:8001
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 本地开发不需要代理头
TRUST_PROXY_HEADERS=false

# ── 日志级别（开发时可用 DEBUG）──────────────────────────────────────────────
LOG_LEVEL=DEBUG

# ── 管理员凭据（开发环境）────────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASS=admin123

# ── OAuth 配置 ──────────────────────────────────────────────────────────────
# 需要创建开发专用的 OAuth App，回调指向本地
# GitHub: https://github.com/settings/developers → New OAuth App
#   - Homepage URL: http://localhost:3000
#   - Authorization callback URL: http://localhost:8001/api/oauth/github/callback
#
# Gitee: https://gitee.com/oauth/applications → 新建应用
#   - 应用主页: http://localhost:3000
#   - 回调地址: http://localhost:8001/api/oauth/gitee/callback
#   - 权限: user_info

GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:8001/api/oauth/github/callback

GITEE_CLIENT_ID=your_gitee_client_id_here
GITEE_CLIENT_SECRET=your_gitee_client_secret_here
GITEE_REDIRECT_URI=http://localhost:8001/api/oauth/gitee/callback
